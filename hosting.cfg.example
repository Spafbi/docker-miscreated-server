-- // NOTE: Lines starting with a dash are commented out. Remove the dash and
-- // space before the CVAR(variable) to customize that CVAR. CVARS which are
-- // commented out will use default settings.
--
-- // IMPORTANT: After setting a value for any CVAR, remove any comments that 
-- // follow the value (the text after the equals sign). For example:
-- // Instead of: http_password= mypassword -- this is a comment
-- // Use: http_password=myPassword
-- // This ensures compatibility with server configuration parsing.
--
-- // Changes to hosting.cfg do not take effect until the server is restarted

-- // All values seen here are the default values for the CVARs, so if you want
-- // to use the default value for a CVAR, simply leave it commented out as it
-- // is here. If you want to change a CVAR, remove the dash and space before
-- // the CVAR and change the value to your desired value.

-- ============================================
-- Required Server Settings
-- http_password and sv_servername, to set the rcon password and server name,
-- respectively, are the only required settings to have a uniquely named and
-- functioning server. All other settings are optional and have default values.
-- ============================================
-- The password used to connect via rcon. Do not set this password to the same value as sv_password.
-- IMPORTANT: change this to a strong, unique password before starting the server.
http_password=ChangeThisRCONPassword
-- The server name displayed in the server browser window. Encapsulate the name in quote.
sv_servername=""

-- ============================================
-- Core Server Settings
-- http_password and sv_servername, to set the rcon password and server name,
-- respectively, are the only required settings to have a uniquely named and
-- functioning server. All other settings are optional and have default values.
-- ============================================
-- sv_allow_prone=0 - Set to 1 to enable prone. Enabling prone also allows for a number of prone-related exploits, so it is recommended to leave this disabled.
-- sv_maxuptime=25.3588 - Maximum server uptime until restart in hours - 12 suggested. While the default is higher than 24, the server will not actually stay up for more than 24 hours without restarting, so setting this to a value higher than 24 will not have any effect.
-- sv_motd="" - This is the first message players will see. Server motd to display when players join the server. Encapsulate the message in quotes if it contains spaces. This is a good place to put server rules or other important information for players to see when they join.
-- sv_msg_conn=0 - A setting of 1 announces connections in chat
-- sv_msg_death=0 - A setting of 1 announces deaths in chat
-- sv_noBannedAccounts=0 - Do not allow any banned steam accounts to join (or those with a private profile) - Steam IDs of accounts added to the server whitelist may still join.
-- sv_password="" Users will also need this setting in their user.cfg file. Note: Users having this setting in user.cfg can only join servers having this password set. Do not set this password if you do not want to restrict access to your server. Do not set this password to the same value as http_password.
-- sv_url="" - This is the second message players will see. Server url to display when players join the server - just a second motd line really. Encapsulate the message in quotes if it contains spaces. This is a good place to put a link to the server website or discord.

-- ============================================
-- Logging
-- ============================================
-- log_chatlog=1 - Log chat messages (1=enabled, 0=disabled)
-- log_damagelog=1 - Log damage events (1=enabled, 0=disabled)
-- log_IncludeTime=5 - Include timestamp in log entries
-- log_Verbosity=0 - Log verbosity level (1-4)
-- log_WriteToFile=1 - Write logs to file (1=enabled, 0=disabled)
-- log_WriteToFileVerbosity=0 - Log verbosity level for file logs (1-4)

-- ============================================
-- Ping Settings
-- ============================================
-- g_pinglimit=0 - Max ping a player can have before being kicked (0=disabled)
-- g_pinglimitGraceTime=15 - Players joining the server on slower connections may have higher ping due to the amount of data being transmitted, so this value is the time in seconds a player has to complete their join and correct their ping before being kicked
-- g_pingLimitTimer=15 - Time in seconds after which a player will be kicked if they are over the specified ping limit

-- ============================================
-- Steam
-- ============================================
-- steam_inventory_enable=1 - Configure the Steam inventory (kiosk system for skins), 1 enabled, 0 disabled.
-- steam_ugc= - Steam UGC (User Generated Content) IDs for server mods. Separate multiple IDs with commas.
-- sv_steamWebAPIKey= - Steam Web API Key for server features. Required for Steam inventory (kiosk system for skins). Get a Steam Web API Key at https://steamcommunity.com/dev/apikey

-- ============================================
-- Weather System
-- ============================================
-- wm_dangerScale=1 - Scale of danger effects
-- wm_disable=0 - Completely disable the weather management system
-- wm_effectScaleOffset=0 - Scales the negative effects environments can have, e.g. 0.03 means environment effects are 3% more dangerous, -0.5 environment is 50% less dangerous.
-- wm_forceTime=1 - Force the server time to a specific 24-hour time, default: -1 (disabled), can be from 0.0 through 24.0
-- wm_pattern=1 - Set a fixed weather pattern. Execute wm_startPattern in RCON to get a list of patterns and their numbers.
-- wm_timeOffset=0 - Time offset to system time, negative = random offset, use 24-x for real negative offsets (as positive numbers)
-- wm_timeScale=2 - Scale time of day speed. This results in a full day passing in 12 real hours with the default setting of 2. Set to 4 for a full day in 6 real hours, 0.5 for a full day in 48 real hours, etc.
-- wm_timeScaleNight=4 - Scale of night speed (relative to day). This is a multiplier to wm_timeScale, so with the default settings of 2 for wm_timeScale and 4 for wm_timeScaleNight, night will pass at 8 times the speed of real time, and 4 times the speed of day time. Set to 1 to have night and day pass at the same speed.
-- wm_timeScaleWeather=1 - Scale of weather speed. Changing this value can make weather changes happen more or less frequently. This is a multiplier to wm_timeScale, so with the default settings of 2 for wm_timeScale and 1 for wm_timeScaleWeather, weather will change at 2 times the speed of real time. Set to 0.5 to have weather change at half the speed of real time, etc.

-- ============================================
-- Game Rules & Player
-- ============================================
-- g_craftingSpeedMultiplier=1 - Set to 2 to make crafting twice as fast. 0.5 to make crafting take twice as long. Set to 1000 to make crafting seem virtually instantaneous.
-- g_gameRules_bases=1 - Server enforced base placement rules, default: 1 (0=no bases, 1=restricted zones, 2=bases everywhere)
-- g_gameRules_Camera=0 - Server enforced camera rules, 0=both, 1=first person only, 2=third person only in vehicle
-- g_maxHealthMultiplier=1 - Scales the default health for a player - default is 1, do not go beyond 5 - experimental
-- g_playerFoodDecay=0.208333 - Food decay speed
-- g_playerFoodDecaySprinting=0.260416 - Food decay speed when sprinting
-- g_playerHealthRegen=0.111 - Health regeneration speed
-- g_playerInfiniteStamina=0 - Set to 1 to enable infinite stamina
-- g_playerTemperatureBodyRate=0.004 - Player temperature body rate
-- g_playerTemperatureEnvRate=0.00125 - Player temperature environment rate
-- g_playerTemperatureRegenSpeed=15 - Player temperature regeneration speed
-- g_playerTemperatureSpeed=1 - Player temperature speed
-- g_playerWaterDecay=0.32407 - Water decay speed
-- g_playerWaterDecaySprinting=0.40509 - Water decay speed when sprinting
-- g_playerWeightLimit=40 - How much weight a player may carry
-- pcs_maxCorpses=20 - Set the maximum number of player corpses
-- pcs_maxCorpseTime=1200 - Set in seconds the maximum time before a player corpse will despawn if items are not added or removed from their inventory

-- ============================================
-- AI
-- ============================================
-- as_corpseCountMax=20 - Max AI corpses
-- as_corpseRemovalTime=300 - Time in seconds until AI corpse despawns
-- asm_disable=0 - Set to 1 to disable the AI spawner manager system
-- asm_hordeCooldown=900 - AI horde cooldown time in seconds
-- asm_maxMultiplier=1 - Set the multiplier for the AI spawner max amount (max 5)
-- asm_percent=50 - Set the AI spawner location percentage (max is 90) - this helps control the AI spawn density
-- asm_spawnerRecyclerPercent= - Set the percentage of spawners that will be recycled
-- ism_maxCount=500 - range 0 to 5000, the maximum number of item spawners that can have a spawned item concurrently
-- ism_percent=20 - range 0 to 90, the percent of item spawners that can possibly spawn loot

